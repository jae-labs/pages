---
import { deploymentEntries } from '../../config/portfolio';
const calendlyPopupUrl = 'https://calendly.com/luiz1361/30min?background_color=000000&text_color=fff700&primary_color=00f6ff';
---

<section id="deployments" class="py-12 px-6 bg-[#050505] border-y border-white/5 relative">
  <div class="max-w-4xl xl:max-w-6xl 2xl:max-w-7xl mx-auto">
    <div class="mb-16 relative">
      <div class="absolute -left-4 top-1/2 -translate-y-1/2 w-1 h-12 bg-neon-cyan"></div>
      <h2 class="text-4xl md:text-7xl xl:text-7xl 2xl:text-8xl font-black text-white italic uppercase tracking-tighter glitch" data-text="DEPLOYMENTS">DEPLOYMENTS</h2>
    </div>

    <div class="space-y-16">
      {deploymentEntries.map((d) => (
        <div class="relative group border border-white/5 bg-[#050505]/40 backdrop-blur-sm p-8 rounded-2xl overflow-hidden">

          
          <div class="mb-8 border-b border-white/10 pb-4 relative">
             <div class="flex items-center gap-4 mb-4">
                 <span class="text-[10px] font-fira text-[#f3eb2c] border border-[#f3eb2c]/30 px-2 py-0.5 rounded bg-[#f3eb2c]/5 uppercase font-bold">
                   Release {d.release}
                 </span>
                 <span class="text-[10px] font-fira text-[#00ffff] border border-[#00ffff]/30 px-2 py-0.5 rounded bg-[#00ffff]/5 uppercase">
                   Region: {d.region}
                 </span>
                 <span class="text-[10px] font-fira text-[#858585] border border-[#858585]/30 px-2 py-0.5 rounded bg-[#858585]/5 uppercase">
                    Time: {d.period}
                 </span>
                 <span class={`text-[10px] font-fira px-2 py-0.5 rounded border ${d.status === 'CURRENT' ? 'border-[#00ff00]/30 text-[#00ff00] bg-[#00ff00]/5' : 'border-[#858585]/30 text-[#858585] bg-[#858585]/5'} uppercase font-bold`}>
                  {d.status}
                 </span>
              </div>
             <h3 class="text-4xl font-black uppercase tracking-tight">
                <a
                  href={d.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-white transition-colors hover:text-neon-yellow focus-visible:text-neon-yellow focus-visible:outline-none"
                  aria-label={`Open ${d.org} website`}
                >
                  {d.org}
                </a>
              </h3>
             </div>

             <div class="space-y-12 pl-4">
              {d.roles.map((r) => (
               <div class="relative font-fira">
                 <div class="flex items-center gap-4 mb-4">
                    <span class="text-[10px] font-fira text-neon-yellow border border-neon-yellow/30 px-2 py-0.5 rounded bg-neon-yellow/5 uppercase font-bold">
                      Version {r.version}
                    </span>
                    <div class="h-[1px] flex-1 bg-white/5"></div>
                    <span class="text-xs text-[#999] uppercase tracking-[0.2em]">{r.date}</span>
                 </div>

                 <div class="bg-[#0a0a0a] border border-white/5 rounded-lg p-8 group-hover:border-neon-yellow/20 transition-all shadow-inner">
                   <h3 class="text-neon-cyan font-black text-base uppercase tracking-wide">
                      {r.title}
                   </h3>

                   <div class="relative mt-6 group/blur">
                     <a
                       href={calendlyPopupUrl}
                       data-calendly-url={calendlyPopupUrl}
                       class="block relative rounded-xl overflow-hidden border border-dashed border-white/10 p-5 bg-black/40 hover:bg-black/60 hover:border-neon-yellow/30 transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-neon-yellow/70 focus-visible:ring-offset-2 focus-visible:ring-offset-black"
                       aria-label="Decrypt summary by booking a call"
                     >
                       {/* Blurred Text */}
                       <div class="select-none pointer-events-none filter blur-[6px] opacity-30 transition-all duration-300 group-hover/blur:blur-[4px] group-hover/blur:opacity-10 text-xs md:text-sm leading-relaxed text-[#aaa] space-y-2 font-mono">
                         <p>• Optimized production Kubernetes orchestration and cluster scalability boundaries for regional deployment.</p>
                         <p>• Automated telemetry collection pipelines and unified data streams, reducing MTTR metrics by 60%.</p>
                       </div>

                       {/* Overlay CTA */}
                       <div class="absolute inset-0 flex items-center justify-center p-4">
                         <span class="inline-flex items-center justify-center w-10 h-10 rounded-full border border-neon-yellow/30 bg-[#0c0c0c]/90 text-neon-yellow shadow-2xl group-hover/blur:scale-110 group-hover/blur:border-neon-yellow group-hover/blur:bg-neon-yellow group-hover/blur:text-black transition-all duration-300" aria-hidden="true">
                           <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4">
                             <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
                             <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                           </svg>
                         </span>
                       </div>
                     </a>
                   </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
